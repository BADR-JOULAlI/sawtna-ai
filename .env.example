SAWTNA_API_PORT=8010
SAWTNA_NLP_PORT=8011
SAWTNA_ANALYTICS_PORT=8012
SAWTNA_WEB_PORT=5175
# Local-only development key. Set a long random key before any deployment.
SAWTNA_SERVICE_KEY=local-sawtna-development-only
SAWTNA_ADMIN_KEY=local-sawtna-admin-only
SAWTNA_EMBEDDER=concept-hash-v1
# For a trained multilingual encoder: install .[ml] and set multilingual-e5-small.
SAWTNA_MODEL_DEVICE=cpu
SAWTNA_ALLOW_UNREVIEWED=false
POSTGRES_PASSWORD=local-sawtna-postgres
