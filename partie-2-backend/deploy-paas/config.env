# Paramètres NON secrets du déploiement PaaS du backend Sawtna (étudiant 2).
# Les secrets sont générés dans .secrets/paas.env (jamais commité).

RG=rg-sawtna-backend-paas
# Régions autorisées par Azure for Students ESI : francecentral, polandcentral,
# belgiumcentral, austriaeast, italynorth. En austriaeast, PostgreSQL B1ms est refusé
# (SkuNotAvailable) pour cet abonnement -> base + Container Apps en polandcentral.
RG_LOC=austriaeast                    # groupe de ressources (métadonnées seulement, déjà créé)
LOC=polandcentral                     # ACR + PostgreSQL + environnement Container Apps

ACR=sawtnabackacr$(date +%y%m)        # recalculé une seule fois, puis figé dans .secrets/paas.env
ACA_ENV=sawtna-backend-env
APP_BACKEND=sawtna-backend
APP_NLP=sawtna-nlp-hash               # NLP interne (concept-hash-v1), non exposé sur Internet
IMAGE_REPO=sawtna-app

PG_SERVER=sawtna-pg-$(openssl rand -hex 3)   # nom global unique, figé dans .secrets/paas.env
PG_ADMIN=sawtna
PG_DB=sawtna
PG_SKU=Standard_B1ms                  # Burstable, le moins cher
PG_TIER=Burstable
PG_VERSION=16
PG_STORAGE_GB=32

# NLP utilisé par le backend :
#   internal -> conteneur concept-hash-v1 déployé ici (même comportement que la VM)
#   shared   -> NLP E5 de Badr (index reconstruit, voir README §NLP)
NLP_MODE=shared
SHARED_NLP_URL=https://sawtna-nlp.jollyhill-841f0ea8.austriaeast.azurecontainerapps.io

SAWTNA_ALLOWED_ORIGINS=https://localhost,http://130.162.52.219
SAWTNA_ANALYTICS_URL=https://sawtna-analytics.duckdns.org
