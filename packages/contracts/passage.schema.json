{
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^[a-zA-Z0-9_.:-]{1,150}$",
      "title": "Id",
      "type": "string"
    },
    "document_id": {
      "pattern": "^[a-zA-Z0-9_.:-]{1,100}$",
      "title": "Document Id",
      "type": "string"
    },
    "title": {
      "maxLength": 500,
      "minLength": 2,
      "title": "Title",
      "type": "string"
    },
    "source_url": {
      "format": "uri",
      "maxLength": 2083,
      "minLength": 1,
      "title": "Source Url",
      "type": "string"
    },
    "language": {
      "default": "fr",
      "enum": [
        "fr",
        "ar",
        "darija"
      ],
      "title": "Language",
      "type": "string"
    },
    "text": {
      "maxLength": 12000,
      "minLength": 30,
      "title": "Text",
      "type": "string"
    },
    "section": {
      "default": "",
      "maxLength": 300,
      "title": "Section",
      "type": "string"
    },
    "page": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Page"
    },
    "status": {
      "default": "pending_review",
      "enum": [
        "reviewed",
        "pending_review",
        "synthetic"
      ],
      "title": "Status",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Sha256",
      "type": "string"
    }
  },
  "required": [
    "id",
    "document_id",
    "title",
    "source_url",
    "text",
    "sha256"
  ],
  "title": "Passage",
  "type": "object"
}
